# Runtime: development or production
APP_ENV=development
# Public HTTPS URL after deployment
PUBLIC_BASE_URL=http://localhost:8000
# Persistent SQLite database
DB_PATH=./data/reliefsync.db
# Set a long random secret before production
SALT=
# Set a separate long random coordinator password before production
COORDINATOR_TOKEN=
# Open simulated approvals; real cards always require coordinator authentication
DEMO_MODE=true
# From BotFather /newbot
TELEGRAM_BOT_TOKEN=
# Bot username without @
TELEGRAM_BOT_USERNAME=
# polling or webhook
TELEGRAM_MODE=polling
# Random secret required for webhook mode
TELEGRAM_WEBHOOK_SECRET=
# short or off
TELEGRAM_ACK_MODE=short
# Optional test group invite URL
TEST_GROUP_URL=
# Optional feedback form URL
FEEDBACK_URL=
# Provider Chat Completions base URL ending in /v1
LLM_BASE_URL=
# Provider API key
LLM_API_KEY=
# Model identifier from your provider
LLM_MODEL=
# Set false for providers without JSON object mode
LLM_JSON_MODE=true
# Extraction request timeout
LLM_TIMEOUT_S=20
# Number of pipeline workers (one app process only)
LLM_CONCURRENCY=4
# Permit offline rule extractor on provider failure
ALLOW_FALLBACK_EXTRACTOR=true
# Explicit opt-in: replace contact before enabling remote geocoding
GEOCODER_USER_AGENT=
# Empty disables remote geocoding; local gazetteer always works
GEOCODER_URL=
# Radius for suggested matches
MATCH_RADIUS_KM=3
# Minimum weighted score
MATCH_MIN_SCORE=0.5
# Same-sender duplicate window
DEDUPE_WINDOW_MIN=120
# Logging severity
LOG_LEVEL=INFO
# Domain or :80 for HTTP-by-IP deployment
SITE_ADDRESS=:80
